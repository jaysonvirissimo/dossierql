{
  "name": "dossierql",
  "private": true,
  "description": "A browser game that teaches GraphQL through espionage casework.",
  "homepage": "https://virissimo.info/dossierql/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaysonvirissimo/dossierql.git"
  },
  "bugs": "https://github.com/jaysonvirissimo/dossierql/issues",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "world:build": "node --disable-warning=ExperimentalWarning scripts/build-world.ts && node --disable-warning=ExperimentalWarning scripts/build-map.ts",
    "content:validate": "node --disable-warning=ExperimentalWarning scripts/validate-content.ts",
    "check:bundle": "node --disable-warning=ExperimentalWarning scripts/check-bundle.ts",
    "check:origins": "node --disable-warning=ExperimentalWarning scripts/check-origins.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run content:validate && npm run build && npm run check:bundle && npm run check:origins"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "cm6-graphql": "^1.0.0",
    "codemirror": "^6.0.2",
    "graphql": "^17.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
